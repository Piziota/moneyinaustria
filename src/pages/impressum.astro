---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailLink from '../components/EmailLink.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="Impressum"
  description={`Legal disclosure (Impressum) for ${siteConfig.siteName} under the Austrian E-Commerce Act and Media Act.`}
  path="/impressum/"
>
  <div class="container">
    <div class="hero">
      <span class="badge">Legal</span>
      <h1>Impressum</h1>
      <p class="lead">
        Disclosure required under § 5 E-Commerce-Gesetz (ECG) and § 25
        Mediengesetz (MedienG).
      </p>
    </div>

    <div class="prose" style="padding-block: 1rem 3rem;">
      <h2>Site owner</h2>
      <p>
        {siteConfig.ownerName}<br />
        {siteConfig.address}<br />
        {siteConfig.postalCode} {siteConfig.city}, {siteConfig.country}<br />
        Email: <EmailLink email={siteConfig.email} />
      </p>

      <h2>Purpose of this website</h2>
      <p>
        {siteConfig.siteName} is a private, non-commercial website. It is run for
        informational purposes only, does not sell products or advertising
        space, and does not generate revenue. It exists to help newcomers
        understand how everyday financial matters work in Austria: taxes,
        social insurance, banking, pensions, family benefits, and investing.
      </p>

      <h2>No financial or tax advice</h2>
      <div class="callout">
        <p>
          The content on this website is general information written for a
          non-specialist audience. It is not financial, tax, or legal advice
          and does not replace individual consultation with a qualified
          <em lang="de">Steuerberater</em> (tax advisor), lawyer, or the
          relevant Austrian authority. No liability is accepted for decisions
          made based on this content.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
