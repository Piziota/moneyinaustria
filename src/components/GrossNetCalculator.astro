---
import { TAX_RATES, CURRENT_TAX_YEAR } from '../data/tax-rates';

const rates = TAX_RATES[CURRENT_TAX_YEAR];
---

<div class="prose">
  <h2>Gross to net calculator</h2>

  <div class="callout">
    <p>
      This calculator runs entirely in your browser. Nothing you type into
      it is sent to any server, saved, or logged anywhere, including by us.
    </p>
  </div>

  <div class="calculator-card">
    <form id="gross-net-form" class="calculator-form">
      <div class="form-field">
        <label for="gross-monthly">Gross monthly salary (EUR)</label>
        <input type="number" id="gross-monthly" name="gross-monthly" min="0" step="0.01" placeholder="e.g. 3000" required />
      </div>

      <div class="form-field">
        <label for="payments-per-year">Payments per year</label>
        <select id="payments-per-year" name="payments-per-year">
          <option value="14" selected>14 (12 monthly plus 13th and 14th salary)</option>
          <option value="12">12 (no 13th/14th salary)</option>
        </select>
      </div>

      <div class="form-field">
        <label for="region">Where you're insured</label>
        <select id="region" name="region">
          <option value="vienna" selected>Vienna</option>
          <option value="restOfAustria">Rest of Austria</option>
        </select>
      </div>

      <button type="submit" class="btn">Calculate</button>
    </form>

    <div id="gross-net-unconfigured" class="callout" hidden>
      <p>
        This calculator isn't ready yet. The tax and social insurance
        figures in <code>src/data/tax-rates.ts</code> are still
        placeholders and need to be verified against an official source
        before this can compute a real number.
      </p>
    </div>

    <div id="gross-net-result" class="calculator-result" hidden></div>
  </div>

  <h3>Assumptions</h3>
  <ul>
    <li>In scope: {rates.scope.inScope}</li>
    <li>Vienna raised its employee Wohnbauförderungsbeitrag share from 0.5% to 0.75% on 1 January 2026; select "Rest of Austria" above if you're insured elsewhere, since Vienna is currently the only Bundesland with a different rate.</li>
    <li>Out of scope: {rates.scope.outOfScope.join('; ')}.</li>
    <li>Only the Verkehrsabsetzbetrag is applied automatically. Anything you'd need to actively claim, such as the Familienbonus Plus, an increased Verkehrsabsetzbetrag, or the Pendlerpauschale, is not included.</li>
  </ul>
  <p class="article-meta">Figures last verified: {rates.lastVerified}. See <code>docs/AUSTRIA-TAX-DATA-2026.md</code> for sources.</p>

  <div class="callout">
    <p>
      <strong>Estimate only, not tax advice.</strong> This is a simplified
      model of a standard payslip, not a substitute for your actual payslip,
      your employer's payroll department, or a <em lang="de">Steuerberater</em>
      (tax advisor). Individual circumstances vary; use this to get a
      general sense of your net pay, not a figure to plan around exactly.
    </p>
  </div>
</div>

<script>
  import { calculateGrossToNet, formatEUR, type GrossNetResult } from '../utils/grossNetCalculator';
  import { TAX_RATES, CURRENT_TAX_YEAR } from '../data/tax-rates';
  import type { PaymentsPerYear, Region } from '../utils/grossNetCalculator';

  const rates = TAX_RATES[CURRENT_TAX_YEAR];
  const form = document.getElementById('gross-net-form') as HTMLFormElement | null;
  const resultEl = document.getElementById('gross-net-result') as HTMLDivElement | null;
  const unconfiguredEl = document.getElementById('gross-net-unconfigured') as HTMLDivElement | null;

  function renderResult(result: GrossNetResult): string {
    const breakdownRows = result.socialInsuranceBreakdown
      .map((line) => `<tr><td>${line.label}</td><td>${formatEUR(line.amount)}</td></tr>`)
      .join('');

    let html = `
      <h3>Net monthly pay: ${formatEUR(result.netMonthly)}</h3>
      <div class="table-scroll">
        <table class="tax-table">
          <tbody>
            <tr><td>Gross monthly</td><td>${formatEUR(result.grossMonthly)}</td></tr>
            ${breakdownRows}
            <tr><td>Social insurance and payroll levies (total)</td><td>${formatEUR(result.socialInsuranceMonthly)}</td></tr>
            <tr><td>Wage tax</td><td>${formatEUR(result.wageTaxMonthly)}</td></tr>
            <tr><td><strong>Net monthly</strong></td><td><strong>${formatEUR(result.netMonthly)}</strong></td></tr>
          </tbody>
        </table>
      </div>
      <h4>How this was calculated</h4>
      <ol>${result.steps.map((s) => `<li>${s}</li>`).join('')}</ol>
    `;

    if (result.specialPayment) {
      html += `<h3>13th &amp; 14th salary, combined (per year)</h3>`;
      if (result.specialPayment.configured) {
        html += `
          <div class="table-scroll">
            <table class="tax-table">
              <tbody>
                <tr><td>Combined gross</td><td>${formatEUR(result.specialPayment.combinedGrossAnnual)}</td></tr>
                <tr><td>Social insurance</td><td>${formatEUR(result.specialPayment.socialInsuranceAnnual)}</td></tr>
                <tr><td>Wage tax</td><td>${formatEUR(result.specialPayment.wageTaxAnnual)}</td></tr>
                <tr><td><strong>Net, combined</strong></td><td><strong>${formatEUR(result.specialPayment.netAnnual)}</strong></td></tr>
                <tr><td>≈ net per payment</td><td>${formatEUR(result.specialPayment.netPerPaymentEstimate)}</td></tr>
              </tbody>
            </table>
          </div>
          <ol>${result.specialPayment.steps.map((s) => `<li>${s}</li>`).join('')}</ol>
        `;
      } else {
        html += `<p>${result.specialPayment.steps.join(' ')}</p>`;
      }
    }

    return html;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const grossInput = document.getElementById('gross-monthly') as HTMLInputElement | null;
    const paymentsInput = document.getElementById('payments-per-year') as HTMLSelectElement | null;
    const regionInput = document.getElementById('region') as HTMLSelectElement | null;
    if (!grossInput || !paymentsInput || !regionInput || !resultEl || !unconfiguredEl) return;

    const grossMonthly = Number(grossInput.value);
    const paymentsPerYear = Number(paymentsInput.value) as PaymentsPerYear;
    const region = regionInput.value as Region;

    if (!Number.isFinite(grossMonthly) || grossMonthly <= 0) return;

    const result = calculateGrossToNet({ grossMonthly, paymentsPerYear, region }, rates);

    if (!result.configured) {
      resultEl.hidden = true;
      unconfiguredEl.hidden = false;
      return;
    }

    unconfiguredEl.hidden = true;
    resultEl.hidden = false;
    resultEl.innerHTML = renderResult(result);
  });
</script>
