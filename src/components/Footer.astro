---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="disclaimer">
      <strong>Not financial advice.</strong> {siteConfig.siteName} is an independent, informational
      guide to help newcomers understand how money, taxes, and benefits work in Austria.
      It is written in plain English and is not a substitute for advice from a tax
      advisor (<em lang="de">Steuerberater</em>), lawyer, or your local social insurance
      office. Rules change, so always confirm details with an official source before
      making decisions.
    </div>
    <p class="footer-meta">
      © {year} {siteConfig.siteName} · <a href="/about/">About this project</a> ·
      <a href="/impressum/">Impressum</a> · <a href="/privacy/">Privacy</a> ·
      <a href="/contact/">Contact</a>
    </p>
  </div>
</footer>
